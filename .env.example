# ServiceForce.ai - Environment Variables Example
# Duplicate this file to .env for local overrides

# Application
PROJECT_NAME="ServiceForce.ai"
ENVIRONMENT="development"
DEBUG=true
DEMO_MODE=true

# Security (Generate a strong random string in production)
SECRET_KEY="replace_with_a_secure_random_secret_key_at_least_32_chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Local SQLite default:
DATABASE_URL="sqlite:///./serviceforce.db"
# PostgreSQL + pgvector for Docker / Production:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/serviceforce"

# Redis Cache & Background Jobs
REDIS_URL="redis://localhost:6379/0"

# AI Speech & Vector Providers (Optional: leaves platform in local simulation mode if omitted)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
EMBEDDING_MODEL="text-embedding-004"

# Telephony Gateway Configuration
# Options: "mock", "asterisk", "sip_gateway"
TELEPHONY_PROVIDER="mock"
ASTERISK_HOST="localhost"
ASTERISK_PORT=5060
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER="serviceforce_ami"
ASTERISK_AMI_SECRET="replace_with_strong_ami_secret"

# Outbound Calling Window Limits (24-hour UTC or local time)
DEFAULT_CALLING_HOURS_START="09:00"
DEFAULT_CALLING_HOURS_END="20:00"
MAX_CAMPAIGN_CONCURRENCY=5

# Webhook Security
WEBHOOK_SIGNING_SECRET="whsec_replace_with_random_hmac_secret"

# Browser origins allowed to call this API.
# Development: the default regex permits any localhost port, which is what
# `flutter run -d chrome` and `python -m http.server` need.
# Production: list the exact origins and clear the regex.
# BACKEND_CORS_ORIGINS='["https://app.serviceforce.ai"]'
# BACKEND_CORS_ORIGIN_REGEX=""
